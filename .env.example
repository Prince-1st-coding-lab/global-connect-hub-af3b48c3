# Copy this file to `.env` and fill in your values.
# After changes, restart the dev server (Vite only reads env at startup).

# Base URL of your backend, e.g. https://api.noblespaces.com
# Leave EMPTY to keep the site running on the built-in local service data.
VITE_API_URL=

# Token used by the /admin page to authenticate write requests.
# This is sent as `Authorization: Bearer <token>` on POST/PUT/DELETE.
# Treat it like a password — do NOT publish it.
VITE_ADMIN_TOKEN=
